{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "globaltalent-connections.com"
        }
      ],
      "destination": "https://www.globaltalent-connections.com/:path*",
      "permanent": true
    },
    {
      "source": "/empleos",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    },
    {
      "source": "/empleos/:id",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    },
    {
      "source": "/beneficios",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    },
    {
      "source": "/calculadora-ahorro",
      "destination": "https://www.globaltalent-connections.com/servicios",
      "permanent": true
    },
    {
      "source": "/blog/herramientas-vacantes-internacionales",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    },
    {
      "source": "/blog/oferta-trabajo-remoto-confiable-estafa",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    },
    {
      "source": "/blog/como-conseguir-trabajo-remoto-euros",
      "destination": "https://www.globaltalent-connections.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:ruta(nosotros|contacto|servicios|blog|politica-de-privacidad|asistente-virtual|que-es-gtc)",
      "destination": "/spa.html"
    },
    {
      "source": "/blog/sitemap.xml",
      "destination": "/api/blog-sitemap"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/blog-articulo?slug=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
